<poml>
  <let name="defaults" src="defaults.json" />
  <let name="request_text" value="typeof user_prompt === 'string' ? user_prompt : ''" />
  <let name="show_footer" value="typeof custom_data === 'undefined' || custom_data === null ? false : custom_data.show_footer === true" />
  <role>{{defaults.role}}</role>
  <task>Help with the current request using the instructions below.</task>
  <cp caption="Instructions">
    <list>
      <item for="rule in defaults.rules">{{loop.index + 1}}. {{rule}}</item>
    </list>
  </cp>
  <cp caption="Current request" if="request_text"><p>{{request_text}}</p></cp>
  <p if="!request_text">No current request supplied; use the latest conversation message.</p>
  <include src="footer.poml" if="show_footer" />
  <output-format>Use concise paragraphs and state uncertainty when needed.</output-format>
</poml>
