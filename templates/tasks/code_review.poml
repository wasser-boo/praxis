<poml>
  <role>You are a senior software developer reviewing code.</role>

  <task>
    <p>Review the following <b>{{ language }}</b> code from <b>{{ filename }}</b>:</p>

    <code lang="{{ language }}">{{ code }}</code>

    <p>Provide feedback on:</p>
    <list>
      <item>Code quality and readability</item>
      <item>Potential bugs or issues</item>
      <item>Performance considerations</item>
      <item>Suggestions for improvement</item>
    </list>
  </task>
</poml>
