# Memory is explicit, user-scoped and evidence-based, not an automatic coding task.
@name "Reflect and remember"
@version "1.0"
@steps [observe, learn, apply, reflect, done]

[state observe]
settings.system_template = "researcher"

[state learn]
settings.system_template = "standard"

[state apply]
settings.system_template = "standard"

[state reflect]
settings.system_template = "tasks/feedback"

[state done]
settings.system_template = "tasks/done"
