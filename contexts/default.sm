# Compatibility workflow name. Use sm_file = standard for editable persona routing.
# This generic workflow no longer forces every user into a coding pipeline.
@name "Default assistant (compatibility)"
@version "1.0"
@steps [standard]

[state standard]

[overrides]
if custom_data.user_prompt =~ "(?i)^\s*(please\s+)?(be|act as|switch to|use)\s+(a\s+|my\s+|the\s+)?language[ _-]?(instructor|teacher|tutor)\b" -> settings.system_template = "language_instructor"
if custom_data.user_prompt =~ "(?i)^\s*(switch to|use|return to)\s+(the\s+)?standard\b" -> settings.system_template = "standard"
