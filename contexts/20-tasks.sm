# Opt-in real-state experiment. Standard conversations are NOT migrated.
# The model selects active_state with set_context. No keyword auto-rules,
# turn counters, deterministic task classifier, or automatic phase queue.
# @steps supplies only initialization. All declared states are selectable.
# sm_data.role is a derived compatibility/memory label, NEVER a routing input.
@name "20 tasks — model-selected working states"
@version "1.0"
@steps [standard]

[state standard]
settings.system_template = "20-tasks"
settings.activated_tools = ["core_files", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "standard"
sm_data.state_goal = "Answer ordinary questions directly; clarify genuinely missing requirements."

[state code_architect]
settings.system_template = "20-tasks"
settings.activated_tools = ["core_files", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "code_architect"
sm_data.state_goal = "Design boundaries, interfaces, trade-offs and acceptance criteria."

[state senior_dev]
settings.system_template = "20-tasks"
settings.activated_tools = ["core_files", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "senior_dev"
sm_data.state_goal = "Assess a proposed implementation plan and its readiness, risks and verification."

[state expert_programmer]
settings.system_template = "20-tasks"
settings.activated_tools = ["coding", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "expert_programmer"
sm_data.state_goal = "Implement an understood requirement precisely and provide meaningful checks."

[state debugger]
settings.system_template = "20-tasks"
settings.activated_tools = ["coding", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "debugger"
sm_data.state_goal = "Explain a failure from evidence, fix its cause, and specify a regression check."

[state code]
settings.system_template = "20-tasks"
settings.activated_tools = ["coding", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "code"
sm_data.state_goal = "Explain programming or command semantics without inventing execution."

[state review]
settings.system_template = "20-tasks"
settings.activated_tools = ["core_files", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "review"
sm_data.state_goal = "Find concrete defects and security or correctness risks in supplied work."

[state teach]
settings.system_template = "20-tasks"
settings.activated_tools = ["agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "teach"
sm_data.state_goal = "Teach or correct the requested language example at an appropriate level."

[state research]
settings.system_template = "20-tasks"
settings.activated_tools = ["core_files", "search_tools", "search_skills", "agent_basic", "role_switch"]
settings.tool_discovery_mode = "DescriptionOnly"
sm_data.role = "research"
sm_data.state_goal = "Compare evidence, qualify conclusions and distinguish sources from assertions."

# Tool allowance per working state. Groups are workflow-local; there are no
# built-in groups. Keep set_context everywhere so the model can change state.
[tool_groups]
role_switch = [set_context, get_context]
core_files = [read_file, write_file, edit_file]
coding = [core_files, execute_terminal, search_tools]
agent_basic = [agent_complete, agent_next, agent_feedback, search_tools, search_skills, use_skill, read_tool_result]
