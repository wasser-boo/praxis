# Explicit coding phases. Use agent_next to advance; turn counts are not completion evidence.
@name "Coding workflow"
@version "1.0"
@steps [understand, code, test, review, done]

[state understand]
settings.system_template = "tasks/plan"

[state code]
settings.system_template = "tasks/code"

[state test]
settings.system_template = "tasks/test"

[state review]
settings.system_template = "tasks/code_review"

[state done]
settings.system_template = "tasks/done"
